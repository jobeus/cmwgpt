# Required Configuration
DISCORD_BOT_TOKEN=
OPENAI_API_KEY=

# Optional Configuration
DISCORD_CHANNEL_ID=
DEFAULT_MODEL=gpt-5-mini
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream

INCLUDE_USERNAMES=true
REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=100

# Auto-Update Features
KEEP_UP_TO_DATE_WITH_GIT=false
QUIET_UPDATES=false

VECTOR_STORE_ID=

# OpenAI Function Calling
USER_CONTEXT_URL=

# Proxy Configuration (for yt-dlp to bypass IP bans)
# Format: host:port:username:password
# Example: proxy.example.com:10001:username:password
PROXY_ADDRESS=

# Note: System prompt is now configured in system_prompt.txt file
# instead of SYSTEM_PROMPT environment variable

# runpod.io api key for extended image generation
RUNPOD_IO_API_KEY=

# openrouter.ai api key for text / chat models
OPENROUTER_API_KEY=