# Required Configuration
DISCORD_BOT_TOKEN=
# Needed for the google / google-high text models and image generation (/draw, /edit)
GEMINI_API_KEY=
# Needed for the sonnet-5.5-direct / opus-5.5-direct text models (Claude API), the default
ANTHROPIC_API_KEY=
# Optional: client-side timeout (seconds) for Gemini requests (default 120)
GEMINI_TIMEOUT_SECONDS=
RAPIDAPI_KEY=
GROQ_API_KEY=

# Pydantic Logfire write token (Project settings -> Write tokens). With it set, the bot sends
# traces (every model call, tool call, mention, slash command, HTTP and Redis call) and its
# INFO+ logs to Logfire. LOGFIRE_API_KEY works too. Leave empty to turn tracing off.
LOGFIRE_TOKEN=
# Optional: the environment shown in Logfire (default: development for .env.development, else production)
# LOGFIRE_ENVIRONMENT=

# Redis: user memory and content caches
REDIS_URL=redis://127.0.0.1:6379/0


# Optional Configuration
DEFAULT_MODEL=sonnet-5.5-direct
# Image model for /draw, /edit and the draw tools until a channel picks one with /imagemodel:
# gemini-nano-banana-2.1, gemini-3-pro-image or gemini-3.1-flash-lite-image
DEFAULT_IMAGE_MODEL=gemini-nano-banana-2.1

REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=10
# Model the nightly user-memory job uses (default sonnet-5.5-direct, needs ANTHROPIC_API_KEY)
# MEMORY_MODEL=sonnet-5.5-direct

# Auto-Update Features
# Deploy webhook: GitHub Actions POSTs here after CI passes on main, and the bot
# pulls + restarts. Leave the secret empty to disable the listener.
# Generate one with: openssl rand -hex 32  (same value goes in the repo's
# DEPLOY_WEBHOOK_SECRET Actions secret)
DEPLOY_WEBHOOK_SECRET=
DEPLOY_WEBHOOK_HOST=0.0.0.0
DEPLOY_WEBHOOK_PORT=8787
QUIET_UPDATES=false

# Note: System prompt is now configured in system_prompt.txt file
# instead of SYSTEM_PROMPT environment variable

TRANSCRIPT_PROXY=

# Optional: explicit path to the env file to load, overriding the default
# .env.production / .env lookup (set this in the shell environment)
# CMWGPT_ENV_FILE=

DISCORD_GUILD_ID=
DEATH_CHANNEL_ID=

# The channel's old IRC log (irssi format), searchable by the direct models'
# search_irc_log/read_irc_log_day tools. Leave unset to turn them off.
# IRC_LOG=cmw.txt
# An irssistats-style nicks file ("canonical regex" per line, first match wins,
# <NULL> drops a nick) that merges IRC aliases in those tools' nick filters and counts.
# IRC_NICKS=irssinicks

# The old IRC quote bot's quotes, one per line, for the direct models'
# old_quotes tool. Leave unset to turn it off.
# OLD_QUOTE_BOT=quote.txt
