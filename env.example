# Required Configuration
DISCORD_BOT_TOKEN=
# openrouter.ai api key for text / chat models
OPENROUTER_API_KEY=
# Needed for the google / google-high text models
GEMINI_API_KEY=
# Needed for the sonnet-5.5-direct / opus-5.5-direct text models (Claude API, bypasses OpenRouter)
ANTHROPIC_API_KEY=
# Optional: client-side timeout (seconds) for Gemini requests (default 120)
GEMINI_TIMEOUT_SECONDS=
RAPIDAPI_KEY=
GROQ_API_KEY=

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cmwgpt_user
DB_PASSWORD=your_secure_password
DB_NAME=cmwgpt

# Redis: user memory and content caches (MariaDB above is only read once, to import old memory)
REDIS_URL=redis://127.0.0.1:6379/0


# Optional Configuration
DEFAULT_MODEL=anthropic/claude-sonnet-5.5
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream

INCLUDE_USERNAMES=true
REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=10
# Model the nightly user-memory job uses (default sonnet-5.5-direct, needs ANTHROPIC_API_KEY)
# MEMORY_MODEL=sonnet-5.5-direct
# Max entries kept in the in-memory message cache (default 200)
MAX_CACHE_SIZE=200

# Auto-Update Features
# Deploy webhook: GitHub Actions POSTs here after CI passes on main, and the bot
# pulls + restarts. Leave the secret empty to disable the listener.
# Generate one with: openssl rand -hex 32  (same value goes in the repo's
# DEPLOY_WEBHOOK_SECRET Actions secret)
DEPLOY_WEBHOOK_SECRET=
DEPLOY_WEBHOOK_HOST=0.0.0.0
DEPLOY_WEBHOOK_PORT=8787
QUIET_UPDATES=false

# Note: System prompt is now configured in system_prompt.txt file
# instead of SYSTEM_PROMPT environment variable

# runpod.io api key for extended image generation
RUNPOD_IO_API_KEY=

TRANSCRIPT_PROXY=

# Optional: explicit path to the env file to load, overriding the default
# .env.production / .env lookup (set this in the shell environment)
# CMWGPT_ENV_FILE=

DISCORD_GUILD_ID=
DEATH_CHANNEL_ID=
