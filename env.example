# Auto-Update Features
KEEP_UP_TO_DATE_WITH_GIT=false
QUIET_UPDATES=false

# Note: System prompt is now configured in system_prompt.txt file
# instead of SYSTEM_PROMPT environment variable

# runpod.io api key for extended image generation
RUNPOD_IO_API_KEY=

# openrouter.ai api key for text / chat models
OPENROUTER_API_KEY=

