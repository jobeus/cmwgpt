# Required Configuration
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=
# Needed for the google / google-high / hybrid text models
GEMINI_API_KEY=
# Optional: client-side timeout (seconds) for Gemini requests (default 120)
GEMINI_TIMEOUT_SECONDS=
RAPIDAPI_KEY=
GROQ_API_KEY=

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cmwgpt_user
DB_PASSWORD=your_secure_password
DB_NAME=cmwgpt

# Log Viewer Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
LOG_VIEWER_ALLOWED_ORIGINS=https://your-log-viewer-domain.example
LOG_VIEWER_HOST=127.0.0.1
LOG_VIEWER_DEV_AUTH_ENABLED=false
LOG_VIEWER_DEV_USERNAME=
LOG_VIEWER_DEV_PASSWORD=

# Optional Configuration
DISCORD_CHANNEL_ID=
DEFAULT_MODEL=anthropic/claude-sonnet-5
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream

INCLUDE_USERNAMES=true
REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=10

# Auto-Update Features
KEEP_UP_TO_DATE_WITH_GIT=false
QUIET_UPDATES=false

# Note: System prompt is now configured in system_prompt.txt file
# instead of SYSTEM_PROMPT environment variable

# runpod.io api key for extended image generation
RUNPOD_IO_API_KEY=

# openrouter.ai api key for text / chat models
OPENROUTER_API_KEY=

TRANSCRIPT_PROXY=

DISCORD_GUILD_ID=
DEATH_CHANNEL_ID=