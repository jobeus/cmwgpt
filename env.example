# Required Configuration
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=

# Optional Configuration
DISCORD_CHANNEL_ID=
DEFAULT_MODEL=anthropic/claude-haiku-4.5
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream

INCLUDE_USERNAMES=true
REPLY_TO_MENTIONS=true
