#!/bin/bash
#
# Pre-commit hook for Discord Bot project
# Automatically lints, fixes issues, and ensures code quality
#
# This hook will:
# 1. Check for linting issues in staged files
# 2. Auto-fix issues where possible
# 3. Re-stage fixed files
# 4. Fail the commit if issues can't be auto-fixed
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}[PRE-COMMIT]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[PRE-COMMIT]${NC} ✅ $1"
}

print_warning() {
    echo -e "${YELLOW}[PRE-COMMIT]${NC} ⚠️  $1"
}

print_error() {
    echo -e "${RED}[PRE-COMMIT]${NC} ❌ $1"
}

# Check if required tools are installed
check_dependencies() {
    local missing_deps=()
    
    if ! command -v flake8 &> /dev/null; then
        missing_deps+=("flake8")
    fi
    
    if ! command -v autopep8 &> /dev/null; then
        missing_deps+=("autopep8")
    fi
    
    if [ ${#missing_deps[@]} -ne 0 ]; then
        print_error "Missing required dependencies: ${missing_deps[*]}"
        print_status "Installing missing dependencies..."
        pip install "${missing_deps[@]}"
    fi
}

# Get list of staged Python files
get_staged_python_files() {
    git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py)$' || true
}

# Run tests to ensure functionality isn't broken
run_tests() {
    print_status "Running tests to ensure functionality..."
    if python tests/run_tests.py > /dev/null 2>&1; then
        print_success "All tests passed"
        return 0
    else
        print_error "Tests failed! Please fix failing tests before committing."
        return 1
    fi
}

# Check linting issues in specific files
check_linting() {
    local files=("$@")
    if [ ${#files[@]} -eq 0 ]; then
        return 0
    fi
    
    print_status "Checking linting issues in staged files..."
    
    # Run flake8 on staged files
    if flake8 "${files[@]}" --max-line-length=120 --ignore=E501,W503 > /dev/null 2>&1; then
        print_success "No linting issues found"
        return 0
    else
        return 1
    fi
}

# Auto-fix linting issues
autofix_files() {
    local files=("$@")
    if [ ${#files[@]} -eq 0 ]; then
        return 0
    fi
    
    print_status "Auto-fixing linting issues..."
    
    # Run autopep8 to fix issues
    autopep8 --in-place --aggressive --aggressive "${files[@]}"
    
    print_success "Auto-fix completed"
}

# Check if files were modified by auto-fix
check_modifications() {
    local files=("$@")
    local modified_files=()
    
    for file in "${files[@]}"; do
        if ! git diff --quiet "$file"; then
            modified_files+=("$file")
        fi
    done
    
    echo "${modified_files[@]}"
}

# Main pre-commit logic
main() {
    print_status "Starting pre-commit checks..."
    
    # Check dependencies
    check_dependencies
    
    # Get staged Python files
    staged_files=($(get_staged_python_files))
    
    if [ ${#staged_files[@]} -eq 0 ]; then
        print_status "No Python files staged for commit"
        exit 0
    fi
    
    print_status "Found ${#staged_files[@]} staged Python file(s): ${staged_files[*]}"
    
    # First, check if there are any linting issues
    if check_linting "${staged_files[@]}"; then
        print_success "All staged files pass linting checks"
    else
        print_warning "Linting issues found, attempting auto-fix..."
        
        # Try to auto-fix the issues
        autofix_files "${staged_files[@]}"
        
        # Check which files were modified
        modified_files=($(check_modifications "${staged_files[@]}"))
        
        if [ ${#modified_files[@]} -gt 0 ]; then
            print_status "Auto-fixed files: ${modified_files[*]}"
            
            # Re-stage the fixed files
            git add "${modified_files[@]}"
            print_success "Re-staged fixed files"
        fi
        
        # Check linting again after auto-fix
        if check_linting "${staged_files[@]}"; then
            print_success "All linting issues have been auto-fixed"
        else
            print_error "Some linting issues could not be auto-fixed"
            print_error "Please manually fix the remaining issues and try again"
            print_status "Run 'make lint' to see specific issues"
            exit 1
        fi
    fi
    
    # Run tests to ensure nothing is broken
    if ! run_tests; then
        exit 1
    fi
    
    print_success "Pre-commit checks passed! 🎉"
    print_status "Proceeding with commit..."
}

# Run main function
main "$@"
