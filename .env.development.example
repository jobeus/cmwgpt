# Docker development environment for the bot + Redis.
# Copy this file to .env.development and then fill in the secrets you want to use.

# Required bot/API configuration
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=
# Needed for the google / google-high text models
GEMINI_API_KEY=
# Needed for the sonnet-5.5-direct / opus-5.5-direct text models (Claude API, bypasses OpenRouter)
ANTHROPIC_API_KEY=
RAPIDAPI_KEY=
GROQ_API_KEY=
RUNPOD_IO_API_KEY=

# Redis container
REDIS_URL=redis://redis:6379/0

# Optional bot configuration
DISCORD_CHANNEL_ID=
DEFAULT_MODEL=anthropic/claude-haiku-4.5
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream
REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=10
# Deploy webhook: GitHub Actions POSTs here after CI passes on main, and the bot
# pulls + restarts. Leave the secret empty to disable the listener.
# Generate one with: openssl rand -hex 32  (same value goes in the repo's
# DEPLOY_WEBHOOK_SECRET Actions secret)
DEPLOY_WEBHOOK_SECRET=
DEPLOY_WEBHOOK_HOST=0.0.0.0
DEPLOY_WEBHOOK_PORT=8787
QUIET_UPDATES=false
TRANSCRIPT_PROXY=
DISCORD_GUILD_ID=
DEATH_CHANNEL_ID=
