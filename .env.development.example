# Docker development environment for bot + log-viewer backend + frontend.
# Copy this file to .env.development and then fill in the secrets you want to use.

# Required bot/API configuration
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=
RAPIDAPI_KEY=
GROQ_API_KEY=
RUNPOD_IO_API_KEY=

# MariaDB container + app connection settings
MARIADB_ROOT_PASSWORD=change-me-root
DB_HOST=db
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=cmwgpt_user
DB_PASSWORD=change-me-db
DB_NAME=cmwgpt

# Log viewer backend
LOG_VIEWER_PORT=3001
LOG_VIEWER_HOST=0.0.0.0
LOG_VIEWER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Docker-friendly log viewer login (used instead of PAM when enabled)
LOG_VIEWER_DEV_AUTH_ENABLED=true
LOG_VIEWER_DEV_USERNAME=devadmin
LOG_VIEWER_DEV_PASSWORD=change-me

# Log viewer frontend
VITE_PORT=5173
VITE_API_URL=/api
VITE_SOCKET_URL=/
VITE_BACKEND_PROXY_TARGET=http://backend:3001
VITE_DISCORD_GUILD_ID=

# Optional bot configuration
DISCORD_CHANNEL_ID=
DEFAULT_MODEL=anthropic/claude-haiku-4.5
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream
INCLUDE_USERNAMES=true
REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=10
KEEP_UP_TO_DATE_WITH_GIT=false
QUIET_UPDATES=false
TRANSCRIPT_PROXY=
DISCORD_GUILD_ID=
DEATH_CHANNEL_ID=
MAX_CACHE_SIZE=200