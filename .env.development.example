# Docker development environment for the bot + MariaDB.
# Copy this file to .env.development and then fill in the secrets you want to use.

# Required bot/API configuration
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=
# Needed for the google / google-high text models
GEMINI_API_KEY=
# Needed for the sonnet-5.5-direct text model (Claude API, bypasses OpenRouter)
ANTHROPIC_API_KEY=
RAPIDAPI_KEY=
GROQ_API_KEY=
RUNPOD_IO_API_KEY=

# MariaDB container + app connection settings
MARIADB_ROOT_PASSWORD=change-me-root
DB_HOST=db
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=cmwgpt_user
DB_PASSWORD=change-me-db
DB_NAME=cmwgpt

# Optional bot configuration
DISCORD_CHANNEL_ID=
DEFAULT_MODEL=anthropic/claude-haiku-4.5
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream
INCLUDE_USERNAMES=true
REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=10
KEEP_UP_TO_DATE_WITH_GIT=false
QUIET_UPDATES=false
TRANSCRIPT_PROXY=
DISCORD_GUILD_ID=
DEATH_CHANNEL_ID=
MAX_CACHE_SIZE=200
