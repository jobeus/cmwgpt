# Docker development environment for the bot + Redis.
# Copy this file to .env.development and then fill in the secrets you want to use.

# Required bot/API configuration
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=
# Needed for the google / google-high text models
GEMINI_API_KEY=
# Needed for the sonnet-5.5-direct / opus-5.5-direct text models (Claude API, bypasses OpenRouter)
# and the nightly memory job
ANTHROPIC_API_KEY=
RAPIDAPI_KEY=
GROQ_API_KEY=
RUNPOD_IO_API_KEY=

# Redis: docker-compose.yml points the bot at the redis container itself, so this
# only matters if you run the bot outside Docker against the container.
REDIS_URL=redis://redis:6379/0

# Optional bot configuration
DEFAULT_MODEL=anthropic/claude-sonnet-5.5
DEFAULT_EDIT_MODEL=seedream
DEFAULT_DRAW_MODEL=seedream
REPLY_TO_MENTIONS=true
INCLUDE_NUM_CHATLINES=10
# Model the nightly user-memory job uses (default sonnet-5.5-direct, needs ANTHROPIC_API_KEY)
# MEMORY_MODEL=sonnet-5.5-direct
# Client-side timeout (seconds) for Gemini requests (default 120)
# GEMINI_TIMEOUT_SECONDS=
QUIET_UPDATES=false
TRANSCRIPT_PROXY=
DISCORD_GUILD_ID=
DEATH_CHANNEL_ID=
DISCORD_CHANNEL_ID=

# Deploy webhook: leave the secret empty in development so a push to main
# doesn't make the dev bot pull and restart too.
DEPLOY_WEBHOOK_SECRET=
DEPLOY_WEBHOOK_HOST=0.0.0.0
DEPLOY_WEBHOOK_PORT=8787
